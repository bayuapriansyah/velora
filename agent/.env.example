# --- BOT Chain connection ---
RPC_URL=https://rpc.bohr.life
CONTRACT_ADDRESS=0xYourDeployedVeloraAddress

# --- Agent's OWN wallet (separate from your personal wallet!) ---
# Generate a fresh one — never reuse your main wallet's key here.
# This wallet only needs a small amount of BOT for gas. It never touches
# the policy's budget directly; the contract releases that on approval.
AGENT_PRIVATE_KEY=0xYourAgentWalletPrivateKey

# --- Gemini (free tier) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
